                    "2. Toss the chips in oil and salt, spread on a tray, and begin baking. (10 mins)", 
                    "3. Brush the pork belly slices generously with BBQ sauce. Place them onto the tray with the chips. (2 mins)", 
                    "4. Return to the oven and bake until the pork is sticky and cooked through, and chips are golden. (15 mins)", 
                    "5. Make the slaw: Cut the apple into thin matchsticks. Mix the apple and cabbage with the mayonnaise. (2 mins)", 
                    "6. Serve the sticky BBQ pork with the hot chips and fresh, crunchy apple slaw. (1 min)"
                ]
            }

        ];



       let selectedPlan = [];

        // UI NAVIGATION
        function switchTab(tabId) {
            // Hide all sections and remove active classes
            document.querySelectorAll('.tab-section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
                // Automatically highlight the correct tab button
                if (btn.getAttribute('onclick').includes(tabId)) {
                    btn.classList.add('active');
                }
            });
            
            // Show the target section
            document.getElementById(tabId).classList.add('active');
            
            if(tabId === 'shopping') generateShoppingList();
        }

        // RENDER LIBRARY
        function renderLibrary() {
            const grid = document.getElementById('recipe-grid');
            grid.innerHTML = '';
            recipes.forEach(recipe => {
                const inPlan = selectedPlan.includes(recipe.id);
                grid.innerHTML += `
                    <div class="card">
                        <h3>${recipe.name}</h3>
                        <p>🕒 ${recipe.time} | 🥩 ${recipe.type}</p>
                        <div class="card-actions">
                            <button class="btn btn-view" onclick="openModal(${recipe.id})">View Details</button>
                            <button class="btn btn-add" onclick="togglePlan(${recipe.id})" ${inPlan ? 'disabled' : ''}>
                                ${inPlan ? 'Added ✓' : 'Add to Plan'}
                            </button>
                        </div>
                    </div>
                `;
            });
        }

	// RENDER PLAN
        function renderPlan() {
            const grid = document.getElementById('plan-grid');
            grid.innerHTML = '';
            if(selectedPlan.length === 0) {
                grid.innerHTML = '<p style="text-align:center; width:100%;">Your plan is empty. Go to the Library to add meals!</p>';
                return;
            }
            selectedPlan.forEach(id => {
                const recipe = recipes.find(r => r.id === id);
                grid.innerHTML += `
                    <div class="card">
                        <h3>${recipe.name}</h3>
                        <div class="card-actions">
                            <button class="btn btn-view" onclick="openModal(${recipe.id})">Cook</button>
                            <button class="btn btn-swap" onclick="swapRecipe(${recipe.id})">Swap 🔄</button>
                            <button class="btn btn-remove" onclick="togglePlan(${recipe.id})">Remove</button>
                        </div>
                    </div>
                `;
            });
        }

        // TOGGLE RECIPE IN PLAN
        function togglePlan(id) {
            if (selectedPlan.includes(id)) {
                selectedPlan = selectedPlan.filter(rId => rId !== id);
            } else {
                selectedPlan.push(id);
            }	
            renderLibrary();
            renderPlan();
            generateShoppingList();
        }

	// SMART SWAP A SINGLE RECIPE
        function swapRecipe(oldId) {
            // 1. Remove the unwanted recipe from the plan
            selectedPlan = selectedPlan.filter(rId => rId !== oldId);

            // 2. Build a "Pantry" out of the REMAINING meals in the plan
            let currentPantry = new Set();
            selectedPlan.forEach(id => {
                let recipe = recipes.find(r => r.id === id);
                recipe.ingredients.forEach(ing => currentPantry.add(getBaseIngredient(ing)));
            });

            // 3. Filter out meals already in the plan AND strictly ban the one we just removed!
            let availableRecipes = recipes.filter(r => !selectedPlan.includes(r.id) && r.id !== oldId);

            // 4. Score the remaining recipes to find the best low-waste match
            let bestScore = -1;
            let bestIndex = -1;

            availableRecipes.forEach((recipe, index) => {
                let score = 0;
                recipe.ingredients.forEach(ing => {
                    if (currentPantry.has(getBaseIngredient(ing))) {
                        score += 1;
                    }
                });
                
                score += Math.random(); // Tie-breaker

                if (score > bestScore) {
                    bestScore = score;
                    bestIndex = index;
                }
            });

            // 5. Add the new winning recipe to the plan
            let nextMeal = availableRecipes[bestIndex];
            selectedPlan.push(nextMeal.id);

            // 6. Refresh the UI
            renderLibrary();
            renderPlan();
            generateShoppingList();
        }
        // HELPER: Strip measurements to find the core ingredient (e.g., "2 tbsp Gochujang" -> "gochujang")
        function getBaseIngredient(item) {
            let lower = item.toLowerCase();
            // FIXED: The forward slash has been properly escaped here (\/) so it doesn't crash the browser!
            return lower.replace(/^(\d+(\.\d+)?(-|\/)?\d*\s*(g|tbsp|tsp|ml|cloves|thumb|tin|handful|heads|packs|stalk|bunch)\s*|^\d+\s*)/, '').trim();
        }

        // SMART SUGGEST 5 MEALS FUNCTION
        function suggestSmartMeals() {
            selectedPlan = []; 
            let availableRecipes = [...recipes]; 
            
            // 1. Pick a random seed meal to start the week
            let seedIndex = Math.floor(Math.random() * availableRecipes.length);
            let firstMeal = availableRecipes.splice(seedIndex, 1)[0];
            selectedPlan.push(firstMeal.id);
            
            // 2. Start a "Pantry" of ingredients we are already buying this week
            let currentPantry = new Set(firstMeal.ingredients.map(getBaseIngredient));

            // 3. Find 4 more meals that share the highest number of ingredients
            while (selectedPlan.length < 5 && availableRecipes.length > 0) {
                let bestScore = -1;
                let bestIndex = -1;

                availableRecipes.forEach((recipe, index) => {
                    let score = 0;
                    
                    // Check how many ingredients overlap with our current pantry
                    recipe.ingredients.forEach(ing => {
                        if (currentPantry.has(getBaseIngredient(ing))) {
                            score += 1;
                        }
                    });
                    
                    // Add a tiny fraction of randomness so ties are broken uniquely each time
                    score += Math.random(); 

                    if (score > bestScore) {
                        bestScore = score;
                        bestIndex = index;
                    }
                });

                // Add the highest scoring meal to the plan
                let nextMeal = availableRecipes.splice(bestIndex, 1)[0];
                selectedPlan.push(nextMeal.id);
                
                // Add the new ingredients to the pantry for the next round of scoring
                nextMeal.ingredients.forEach(ing => currentPantry.add(getBaseIngredient(ing)));
            }

            // Update the UI
            renderLibrary();
            renderPlan();
            switchTab('plan'); 
        }

        // GENERATE SHOPPING LIST
        function generateShoppingList() {
            const listDiv = document.getElementById('shopping-items');
            listDiv.innerHTML = '';
            
            if(selectedPlan.length === 0) {
                listDiv.innerHTML = '<p>No meals selected.</p>';
                return;
            }

            let allIngredients = [];
            selectedPlan.forEach(id => {
                const recipe = recipes.find(r => r.id === id);
                allIngredients = allIngredients.concat(recipe.ingredients);
            });

            // Clean up duplicates (basic string match)
            const uniqueIngredients = [...new Set(allIngredients)].sort();

            uniqueIngredients.forEach(item => {
                if (item !== "Ingredients from card") {
                    listDiv.innerHTML += `
                        <div class="shopping-item">
                            <input type="checkbox" id="item-${item}">
                            <label for="item-${item}">${item}</label>
                        </div>
                    `;
                }
            });
        }

        // MODAL LOGIC
        function openModal(id) {
            const recipe = recipes.find(r => r.id === id);
            document.getElementById('modal-title').innerText = recipe.name;
            document.getElementById('modal-time').innerText = recipe.time;
            document.getElementById('modal-type').innerText = recipe.type;
            
            const ingList = document.getElementById('modal-ingredients');
            ingList.innerHTML = recipe.ingredients.map(i => `<li>${i}</li>`).join('');
            
            const methodDiv = document.getElementById('modal-method');
            methodDiv.innerHTML = recipe.method.map(m => `<p>${m}</p>`).join('');
            
            document.getElementById('recipe-modal').style.display = 'flex';
        }

        function closeModal() {
            document.getElementById('recipe-modal').style.display = 'none';
        }

        // Initialize App
        renderLibrary();
        renderPlan();

    </script>
</body>
</html>
